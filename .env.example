# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Frontend URL(s) allowed to call the API (comma separated)
CORS_ORIGIN=http://localhost:5173

# SQL Server
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=BGTtracker
SQL_USER=<sql-login>
SQL_PASSWORD=<sql-password>
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true

# Authentication - use a long random string (at least 32 characters)
JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRES_IN_HOURS=8

# Logging - files are written to LOG_DIR as app.YYYY-MM-DD.N.log, one per day
LOG_LEVEL=info
LOG_DIR=logs
LOG_RETENTION_DAYS=90

# Prometheus - the scraper sends "Authorization: Bearer <METRICS_TOKEN>" to /metrics.
# Leave empty in development to keep /metrics open; required in production.
METRICS_TOKEN=
